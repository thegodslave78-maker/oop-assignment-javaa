digraph UML { graph [rankdir=TB, bgcolor="white", nodesep=.60, ranksep=1.20, splines=polyline, pad=.18]; node[shape=plain, fontname="DejaVu Sans"]; edge[fontname="DejaVu Sans",fontsize=11,color="#52647D", penwidth=1.6];
LibraryItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F1F5FF"><TR><TD BORDER="1">&lt;&lt;abstract&gt;&gt;<BR/><FONT POINT-SIZE="16"><B>LibraryItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- itemId: String {readOnly}<BR ALIGN="LEFT"/>- title: String<BR ALIGN="LEFT"/>- author: String<BR ALIGN="LEFT"/>- available: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getItemId(): String<BR ALIGN="LEFT"/>+ getTitle(): String<BR ALIGN="LEFT"/>+ setTitle(title): void<BR ALIGN="LEFT"/>+ getAuthor(): String<BR ALIGN="LEFT"/>+ setAuthor(author): void<BR ALIGN="LEFT"/>+ isAvailable(): boolean<BR ALIGN="LEFT"/>+ borrowItem(): boolean<BR ALIGN="LEFT"/>+ returnItem(): boolean<BR ALIGN="LEFT"/>+ getItemType(): String {abstract}<BR ALIGN="LEFT"/>+ getLoanPeriodDays(): int {abstract}<BR ALIGN="LEFT"/>+ displayDetails(): void</FONT></TD></TR></TABLE>>];
PrintedBook [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F0FCF8"><TR><TD BORDER="1"><FONT POINT-SIZE="16"><B>PrintedBook</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- shelfLocation: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getShelfLocation(): String<BR ALIGN="LEFT"/>+ setShelfLocation(value): void<BR ALIGN="LEFT"/>+ getItemType(): String<BR ALIGN="LEFT"/>+ getLoanPeriodDays(): int<BR ALIGN="LEFT"/>+ displayDetails(): void</FONT></TD></TR></TABLE>>];
EBook [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F0FCF8"><TR><TD BORDER="1"><FONT POINT-SIZE="16"><B>EBook</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- fileFormat: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getFileFormat(): String<BR ALIGN="LEFT"/>+ setFileFormat(value): void<BR ALIGN="LEFT"/>+ getItemType(): String<BR ALIGN="LEFT"/>+ getLoanPeriodDays(): int<BR ALIGN="LEFT"/>+ displayDetails(): void</FONT></TD></TR></TABLE>>];
LibraryManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFF8EB"><TR><TD BORDER="1"><FONT POINT-SIZE="16"><B>LibraryManager</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- items: List&lt;LibraryItem&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ addItem(item): boolean<BR ALIGN="LEFT"/>+ findItemById(id): LibraryItem<BR ALIGN="LEFT"/>+ searchItems(keyword): List<BR ALIGN="LEFT"/>+ borrowItem(id): boolean<BR ALIGN="LEFT"/>+ returnItem(id): boolean<BR ALIGN="LEFT"/>+ getAllItems(): List<BR ALIGN="LEFT"/>+ getTotalCount(): int<BR ALIGN="LEFT"/>+ getAvailableCount(): int</FONT></TD></TR></TABLE>>];
LibraryApp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#FFF8EB"><TR><TD BORDER="1"><FONT POINT-SIZE="16"><B>LibraryApp</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- scanner: Scanner<BR ALIGN="LEFT"/>- libraryManager: LibraryManager</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="1"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ run(): void<BR ALIGN="LEFT"/>- showMenu(): void<BR ALIGN="LEFT"/>- displayAllItems(): void<BR ALIGN="LEFT"/>- addPrintedBook(): void<BR ALIGN="LEFT"/>- addEBook(): void<BR ALIGN="LEFT"/>- searchItems(): void<BR ALIGN="LEFT"/>- borrowItem(): void<BR ALIGN="LEFT"/>- returnItem(): void<BR ALIGN="LEFT"/>+ main(args): void</FONT></TD></TR></TABLE>>];
{rank=same; LibraryManager; LibraryApp;}
{rank=same; PrintedBook; EBook;}
PrintedBook -> LibraryItem [arrowhead=empty, arrowsize=1.3];
EBook -> LibraryItem [arrowhead=empty, arrowsize=1.3];
LibraryManager -> LibraryItem [style=dashed, arrowhead=vee, label="manages 0..*", constraint=false];
LibraryApp -> LibraryManager [arrowhead=vee, label="uses"];
LibraryManager -> PrintedBook [style=invis, weight=0];
}